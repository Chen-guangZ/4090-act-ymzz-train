        def MjcActuator "Body_Joint1_actuator"
        {
            uniform double[] mjc:biasPrm = [0, -1.7453292608261108, -0.0872664600610733, 0, 0, 0, 0, 0, 0, 0]
            uniform token mjc:biasType = "affine"
            uniform double mjc:forceRange:max = 100
            uniform double mjc:forceRange:min = -100
            uniform double[] mjc:gainPrm = [1.7453292608261108, 0, 0, 0, 0, 0, 0, 0, 0, 0]
