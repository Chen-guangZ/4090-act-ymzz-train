#usda 1.0
(
    customLayerData = {
        string creator = "URDF USD Converter v0.3.2"
    }
    defaultPrim = "ymbot_d"
    endTimeCode = 1000000
    kilogramsPerUnit = 1
    metersPerUnit = 1
    startTimeCode = 0
    upAxis = "Z"
)

over "ymbot_d" (
    prepend apiSchemas = ["IsaacRobotAPI"]
)
{
    custom rel isaac:physics:robotJoints
    custom rel isaac:physics:robotLinks

    over "Physics"
    {
        over "Body_Joint1" (
            prepend apiSchemas = ["IsaacJointAPI"]
        )
        {
        }

        over "base_footprint_joint" (
            prepend apiSchemas = ["IsaacJointAPI"]
        )
        {
        }

