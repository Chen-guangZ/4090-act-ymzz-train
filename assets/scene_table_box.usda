#usda 1.0
(
    defaultPrim = "World"
    metersPerUnit = 1
    upAxis = "Z"
)

def Xform "World"
{
    # YMBot-D 副本（含头部双目 HeadCamL/R + 腕部 WristCam）
    def "Robot" (
        prepend references = @/home/nvidia4090/ymbot_grasp/assets/ymbot_d_rl/ymbot_d_rl.usda@
    )
    {
    }

    # 桌面（1.6 x 0.8 x 0.04 木纹板，顶面 z = 1.0）
    def Xform "TableTop" (
        prepend references = @/home/nvidia4090/ymbot_grasp/assets/table_white.usda@
    )
    {
        double3 xformOp:translate = (1.3, 0, 0.98)
        uniform token[] xformOpOrder = ["xformOp:translate"]
    }

    # 四条桌腿（0.98 m 高，灰铝色）
    def Xform "TableLegs"
    {
        double3 xformOp:translate = (0, 0, 0)
        uniform token[] xformOpOrder = ["xformOp:translate"]

        def Cube "leg_fl"
        {
            double size = 0.98
            color3f[] primvars:displayColor = [(0.55, 0.56, 0.6)]
            double3 xformOp:scale = (0.08, 0.08, 1)
            double3 xformOp:translate = (0.66, -0.32, 0.49)
            uniform token[] xformOpOrder = ["xformOp:scale", "xformOp:translate"]
        }
        def Cube "leg_fr"
        {
            double size = 0.98
            color3f[] primvars:displayColor = [(0.55, 0.56, 0.6)]
            double3 xformOp:scale = (0.08, 0.08, 1)
            double3 xformOp:translate = (0.66, 0.32, 0.49)
            uniform token[] xformOpOrder = ["xformOp:scale", "xformOp:translate"]
        }
        def Cube "leg_bl"
        {
            double size = 0.98
            color3f[] primvars:displayColor = [(0.55, 0.56, 0.6)]
            double3 xformOp:scale = (0.08, 0.08, 1)
            double3 xformOp:translate = (1.94, -0.32, 0.49)
            uniform token[] xformOpOrder = ["xformOp:scale", "xformOp:translate"]
        }
        def Cube "leg_br"
        {
            double size = 0.98
            color3f[] primvars:displayColor = [(0.55, 0.56, 0.6)]
            double3 xformOp:scale = (0.08, 0.08, 1)
            double3 xformOp:translate = (1.94, 0.32, 0.49)
            uniform token[] xformOpOrder = ["xformOp:scale", "xformOp:translate"]
        }
    }

    # 20 cm 快递盒（印刷纹理），桌面靠机器人侧
    def Xform "Box" (
        prepend references = @/home/nvidia4090/ymbot_grasp/assets/box_cardboard.usda@
    )
    {
        # 6.5 cm 快递盒（源网格 0.2 m，scale 0.325；顶面 1.0 + 0.0325）
        double3 xformOp:translate = (0.9, 0.05, 1.0325)
        double3 xformOp:scale = (0.325, 0.325, 0.325)
        uniform token[] xformOpOrder = ["xformOp:translate", "xformOp:scale"]
    }

    # 灰色地面
    def Xform "Ground"
    {
        double3 xformOp:translate = (0, 0, -0.02)
        uniform token[] xformOpOrder = ["xformOp:translate"]

        def Mesh "floor"
        {
            int[] faceVertexCounts = [4]
            int[] faceVertexIndices = [0, 1, 2, 3]
            point3f[] points = [(-6, -6, 0), (6, -6, 0), (6, 6, 0), (-6, 6, 0)]
            color3f[] primvars:displayColor = [(0.35, 0.35, 0.38)]
        }
    }

    def DomeLight "DomeLight"
    {
        float inputs:intensity = 1500
    }
}
