            prepend apiSchemas = ["IsaacJointAPI"]
        )
        {
        }

        over "Right_Hand_Camera_Joint" (
            prepend apiSchemas = ["IsaacJointAPI"]
        )
        {
        }

        over "Neck_Joint2" (
            prepend apiSchemas = ["IsaacJointAPI"]
        )
        {
        }
    }

    over "Geometry"
    {
        over "base_footprint_link"
        {
            over "base_link" (
                prepend apiSchemas = ["IsaacLinkAPI"]
            )
            {
                over "Body_Link1" (
